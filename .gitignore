.env
*.env
google-service-account.json
.python-version

# Python tooling
pip-log.txt
poetry.lock
.pytest_cache/
.ruff_cache/

# Vite / Node
node_modules/
dist/
.vite/
*.log

# Auto-generated frontend types (run `npm run generate-types` to regenerate)
frontend/src/types/

# Auto-generated frontend data (run `npm run generate-frontend-assets` to regenerate)
frontend/src/generated/

# Coverage reports
.coverage
htmlcov/
coverage.xml
frontend/coverage

# VSCode
.vscode/

# macOS metadata
.DS_Store

# Docker
*.pid
*.db
*.sqlite3

# Compiled output
*.egg-info/
build/
.eggs/
*.manifest
*.spec

# Ignore generated credentials from google-github-actions/auth
gha-creds-*.json

# MyPy
.mypy_cache/

# Hypothesis — keep the examples database (replays found failures as regressions)
/backend/.hypothesis/*
!/backend/.hypothesis/examples/

# LangChain/LangSmith/LangGraph
/backend/.langgraph_api/

