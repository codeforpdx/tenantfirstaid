/backend/scripts/generate_conversation/*.csv
!/backend/scripts/generate_conversation/tenant_questions_facts_full.csv
combined_training_gemini-2.0.jsonl
/.claude/settings.local.json
/.claude/scheduled_tasks.lock
/backend/.eval_history/
/.playwright-mcp

# --- OpenTofu ---------------------------------------------------------------
# Provider plugins and local working state, rebuilt by `tofu init`.
.terraform/
# State never lives in the repository; it lives in the GCS backend. These patterns catch
# a local run that forgot -backend-config, which would otherwise commit resource
# identifiers and any sensitive values the providers recorded.
*.tfstate
*.tfstate.*
crash.log
# Saved plans (`tofu plan -out=...`) embed resource values, including sensitive ones.
tfplan
*.tfplan
# Per-operator inputs, which hold identities such as the reaper's service-account email.
terraform.tfvars
